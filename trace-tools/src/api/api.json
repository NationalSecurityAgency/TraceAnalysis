			"description": "Witness not found",
			"content": {
			    "application/json": {
				"schema" : {}}}}}}},
	"/stringsearch":{
	    "get": {
		"description": "Returns all locations and ticks during which a specified byte array appears in memory",
		"operationId": "stringsearch",
		"parameters": [
		    { "name": "buffer",
		      "in": "query",
		      "description": "Byte array to search for",
		      "required": true,
		      "style": "form",
		      "schema": {
			  "type": "array",
			  "items": {"type":"integer","format":"int32"}
		      }
		    }],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"object",
				    "required": ["buffer_addrs","buffer_creation_ticks","buffer_destruction_ticks"],
				    "properties": {
					"buffer_addrs":{"type":"array","items":{"type":"integer","format":"int64"}},
					"buffer_creation_ticks":{"type":"array","items":{"type":"integer","format":"int64"}},
					"buffer_destruction_ticks":{"type":"array","items":{"type":"integer","format":"int64"}}
				    }}}}}}}},
	"/memory":{
	    "get": {
		"description": "Returns the values in a specified range of memory at a specified tick",
		"operationId": "memory",
		"parameters": [
		    { "name": "tick", "in": "query", "description": "The tick at which to query the memory region", "required": true, "style": "form",
		      "schema": { "type": "integer", "format":"int64"}},
		    { "name": "bank", "in": "query", "description": "The memory bank to query", "required": true, "style": "form",
		      "schema": { "type": "integer", "format":"int64"}},
		    { "name": "base", "in": "query", "description": "The base address of the memory region to query", "required": true, "style": "form",
		      "schema": { "type": "integer", "format":"int64"}},
		    { "name": "len", "in": "query", "description": "The length of the memory region to query", "required": true, "style": "form",
		      "schema": { "type": "integer", "format":"int64"}}
		],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"object",
				    "required":["results","addrs","ticks"],
				    "properties": {
					"results":{"type":"array","items":{"type":"integer","format":"int32"}},
					"addrs":{"type":"array","items":{"type":"integer","format":"int64"}},
					"ticks":{"type":"array","items":{"type":"integer","format":"int64"}}
				    }}}}}}}}},
    "components": {
	"schemas": {
	    "range": {
		"type": "object",
		"required": ["start", "end"],
		"properties": {
		    "start": {"type": "integer","format": "int64"},
		    "end": {"type": "integer", "format": "int64"}}},
	    "slice": {
		"type": "object",
		"required": ["start_index", "depth", "forwards"],
		"properties": {
		    "start_index": {"type": "integer","format": "int64"},
		    "depth": {"type": "integer", "format": "int64"},
		    "forwards": {"type": "boolean"}}},
	    "operation": {
		"type": "object",
		"required": ["index", "opcode", "bank", "addr", "size"],
		"properties": {
		    "index":{"type": "integer", "format": "int64"},
		    "opcode":{"type": "integer", "format": "int64"},
		    "bank":{"type": "integer", "format": "int64"},
		    "addr":{"type": "integer", "format": "int64"},
		    "size":{"type": "integer", "format": "int64"},
		    "val":{"type":"number"},
		    "raw":{"type":"string"},
		    "assocd_addr":{"type": "integer", "format": "int64"},
		    "assocd_bank":{"type": "integer", "format": "int64"},
		    "assocd_size":{"type": "integer", "format": "int64"},
		    "slice_path": {"type": "array", "items": {"type": "integer", "format": "int64"}}}},
	    "instruction": {
		"type": "object",
		"required": ["tick", "pc", "disas", "ops"],
		"properties": {
		    "tick": {"type": "integer", "format": "int64"},
		    "pc": {"type": "integer", "format": "int64"},
		    "disas": {"type": "string"},
		    "ops": {"type": "array", "items": {"$ref": "#/components/schemas/operation"}}}},
	    "object":{
		"type":"object",
		"required":["birth","base","size"],
		"properties":{
		    "birth":{"type":"integer","format":"int64"},
		    "death":{"type":"integer","format":"int64"},
		    "base":{"type":"integer","format":"int64"},
		    "size":{"type":"integer","format":"int64"},
		    "typeid":{"type":"integer","format":"int64"}}},
	    "witness":{
		"type":"object",
		"required":["module_offset","module_path","effect_type","event_type","target_typeid"],
		"properties":{
		    "module_offset":{"type":"integer","format":"int64"},
		    "module_path":{"type":"string"},
		    "register_address":{"type":"integer","format":"int64"},
		    "effect_type":{"type":"enum","values":["reg_write","mem_write_value","mem_write_address","mem_read_value","mem_read_address"]},
		    "event_type":{"type":"enum","values":["object_birth","object_death","object_exists"]},
		    "target_typeid":{"type":"integer","format":"int64"}}},
	    "module":{
		"type":"object",
		"required":["name","path","base"],
		"properties":{
		    "name":{"type":"string"},
		    "path":{"type":"string"},
		    "base":{"type":"integer","format":"int64"},
		    "size":{"type":"integer","format":"int64"}}},
	    "function":{
		"type":"object",
		"required":["module","addr","size"],
		"properties":{
		    "name":{"type":"string"},
		    "namespace":{"type":"string"},
		    "module":{"type":"string"},
		    "addr":{"type":"integer","format":"int64"},
		    "size":{"type":"integer","format":"int64"}}},
	    "block":{
		"type":"object",
		"required":["module","addr","size"],
		"properties":{
		    "module":{"type":"string"},
		    "addr":{"type":"integer","format":"int64"},
		    "size":{"type":"integer","format":"int64"}}},
	    "access":{
		"type":"object",
		"required":["index","tick","addr","size","is_write","pc","disas"],
		"properties":{
		    "index":{"type":"integer","format":"int64"},
		    "tick":{"type":"integer","format":"int64"},
		    "addr":{"type":"integer","format":"int64"},
		    "size":{"type":"integer","format":"int64"},
		    "is_write":{"type":"boolean"},
		    "pc":{"type":"integer","format":"int64"},
		    "disas":{"type":"string"},
		    "val":{"type":"number"},
		    "raw":{"type":"string"},
		    "typeid":{"type":"integer","format":"int64"}}}
	}
    }
}
