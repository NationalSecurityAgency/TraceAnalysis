		"description": "Returns all pcs hit during the trace",
		"operationId": "rmwitness",
		"parameters": [
		    { "name": "witness",
		      "in": "query",
		      "description": "Which witness to remove",
		      "required": true,
		      "style": "form",
		      "schema": {
			  "type": "object",
			  "required": [],
			  "properties": {
			      "module": { "description": "which module contains the witness to be removed",
					  "type":"string"},
			      "offset": { "description": "The offset within the module at which the witness to be removed is located",
					  "type":"integer",
					  "format":"int64"}
			  }
		      }
		    }],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {}}}},
