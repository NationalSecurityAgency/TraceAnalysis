{
    "paths": {
	"/instructions": {
	    "get": {
		"description": "Returns all instructions, along with their operations, matching the query",
		"operationId": "instructions",
		"parameters": [
		    { "name": "max_results", "in": "query", "description": "Maximum number of results to return", "required": false, "style": "form", "schema": { "type": "integer", "format": "int64", "minimum": 1 } },
		    { "name": "get_first", "in": "query", "description": "If true, return the first <max_results> results in tick-order; otherwise, return the last <max_results> results in tick order", "required": false, "style": "form", "schema": { "type": "boolean", "default": true } },
		    { "name": "filter",
		      "in": "query",
		      "description": "Which instructions to return",
		      "required": false,
		      "style": "form",
		      "schema": {
			  "type": "object",
			  "required": [],
			  "properties": {
			      "tick_range": { "description": "Restricts to instructions occuring within this range of ticks", "$ref": "#/components/schemas/range" },
			      "pc_range": { "description": "Restricts to instructions with PC values within this range", "$ref": "#/components/schemas/range" },
			      "data_range": { "description": "Restrict to instructions that access memory within this range", "$ref": "#/components/schemas/range" },
			      "value_range": { "description": "Restrict to instructions that perform operations that result in values in this range", "$ref": "#/components/schemas/range" },
			      "slice": { "description": "Restrict to instructions that ", "$ref": "#/components/schemas/slice" }
			  }
		      }
		    }
		],
		"responses": {
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"array",
				    "items": {"$ref":"#/components/schemas/instruction"}
				}
			    }
			}
		    }
		}
	    }
	},
	"/witnesses":{
	    "get": {
		"description": "Returns all witnesses matching the query",
		"operationId": "witnesses",
		"parameters": [
		    { "name": "filter",
		      "in": "query",
		      "description": "Which instructions to return",
		      "required": false,
		      "style": "form",
		      "schema": {
			  "type": "object",
			  "required": [],
			  "properties": {
			      "pc_range": { "description": "Restrict to witnesses that occur within this range of pcs", "$ref": "#/components/schemas/range" }
			  }
		      }
		    }],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"array",
				    "items": {"$ref":"#/components/schemas/witness"}}}}}}}},
	"/objects":{
	    "get": {
		"description": "Returns all objects matching the query",
		"operationId": "objects",
		"parameters": [
		    { "name": "filter",
		      "in": "query",
		      "description": "Filters which objects to return",
		      "required": false,
		      "style": "form",
		      "schema": {
			  "type": "object",
			  "required": [],
			  "properties": {
			      "tick_range": { "description": "Restricts to objects alive within this range of ticks", "$ref": "#/components/schemas/range" },
			      "address_range": { "description": "Restrict to objects that intersect this range of addesses", "$ref": "#/components/schemas/range" }
			  }
		      }
		    }],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"array",
				    "items": {"$ref":"#/components/schemas/object"}}}}}}}},
	"/modules":{
