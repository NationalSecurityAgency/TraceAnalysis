	"/why":{
	    "get": {
		"description": "Returns the tick of the exit PC of the most recent basic block that executed whose exit control flow, had it taken a different direction than it did in the trace, could have avoided running the basic block containing this pc",
		"operationId": "why",
		"parameters": [
		    { "name": "tick",
		      "in": "query",
		      "description": "The tick for which to return the control flow operation most immediately responsible for executing",
		      "required": true,
		      "style": "form",
		      "schema": { "type": "integer","format":"int64" }
		    }],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"object",
				    "properties":{
					"tick":{"type":"integer","format":"int64"}}}}}}}}},
	"/witnessevents":{
	    "get": {
		"description": "Returns all ",
		"operationId": "witnessevents",
		"parameters": [],
		"responses":{
		    "200": {
			"description": "OK",
			"content": {
			    "application/json": {
				"schema" : {
				    "type":"array",
				    "items": {"type":"object",
					      "required":["module","offset","tick","addr"],
					      "parameters":{
						  "module":{"type":"string"},
						  "offset":{"type":"integer","format":"int64"},
						  "tick":{"type":"integer","format":"int64"},
						  "addr":{"type":"integer","format":"int64"}}}}}}}}}},
